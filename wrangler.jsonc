{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "al-asad-emergency-v49",
  "compatibility_date": "2026-10-10",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./build/sites-worker.ts",
  "d1_databases": [
    {
      "binding": "DB"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET"
    }
  ]
}
